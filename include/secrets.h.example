/* =============================================================================
 * secrets.h.example  --  Template for deployment credentials.
 * -----------------------------------------------------------------------------
 * Copy this file to secrets.h and fill in your own values:
 *     cp include/secrets.h.example include/secrets.h   (POSIX)
 *     copy include\secrets.h.example include\secrets.h  (Windows cmd)
 *
 * secrets.h is gitignored; this template is committed so the required keys are
 * documented. Included by app_config.h (used only by the ROLE_SINK build).
 * ===========================================================================*/
#ifndef APP_SECRETS_H
#define APP_SECRETS_H

/* ---- WiFi (base station only) ------------------------------------------- */
/* For an OPEN (passwordless) network, set APP_WIFI_PASS to nullptr, not "". */
#define APP_WIFI_SSID     "your-wifi-ssid"
#define APP_WIFI_PASS     "your-wifi-password"

/* ---- MQTT broker (base station only) ------------------------------------ */
#define APP_MQTT_HOST     "your-broker.example.com"
#define APP_MQTT_USER     "your-mqtt-user"
#define APP_MQTT_PASS     "your-mqtt-password"

#endif /* APP_SECRETS_H */
